<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯: 위에 「…에서 드리는 온음」, 가운데 곡 이름(두 줄까지)·가수, 아래 이전·재생·다음 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/w_idle"
        android:textColor="@color/w_ink2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="bottom"
        android:maxLines="2"
        android:text="@string/w_idle2"
        android:textColor="@color/w_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink2"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/w_btn"
            android:contentDescription="@string/w_prev"
            android:scaleType="center"
            android:src="@drawable/w_prev" />

        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/w_btn_main"
            android:contentDescription="@string/w_play"
            android:scaleType="center"
            android:src="@drawable/w_play" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/w_btn"
            android:contentDescription="@string/w_next"
            android:scaleType="center"
            android:src="@drawable/w_next" />
    </LinearLayout>
</LinearLayout>
